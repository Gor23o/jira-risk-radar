# Copy this file to .env and fill in your values. Never commit .env.

# Your Jira Cloud site, without a trailing slash
JIRA_BASE_URL=https://your-site.atlassian.net

# The Atlassian account email the API token belongs to
JIRA_EMAIL=you@example.com

# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Create one at https://console.anthropic.com/settings/keys
# Not needed when running with --no-ai
ANTHROPIC_API_KEY=
